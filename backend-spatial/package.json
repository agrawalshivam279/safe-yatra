    "sim:geofence-walk": "tsx src/modules/simulation/scripts/geofenceWalk.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@turf/turf": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^12.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.0",
    "twilio": "^5.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
