{
  "name": "safe-yatra-backend-spatial",
  "version": "1.0.0",
  "description": "Central API gateway and real-time communication hub for Safe Yatra",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
